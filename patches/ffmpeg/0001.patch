+/* CrabbyCut: hai vùng nhớ hw thay được cho nhau (xem send_frame) — cùng thiết bị, định dạng, cỡ. */
+static int hw_frames_compatible(const AVBufferRef *a, const AVBufferRef *b)
+{
+    const AVHWFramesContext *fa, *fb;
+    if (!a || !b)
+        return 0;
+    fa = (const AVHWFramesContext *)a->data;
+    fb = (const AVHWFramesContext *)b->data;
+    return fa->device_ref && fb->device_ref &&
+           fa->device_ref->data == fb->device_ref->data &&
+           fa->format == fb->format && fa->sw_format == fb->sw_format &&
+           fa->width == fb->width && fa->height == fb->height;
+}
