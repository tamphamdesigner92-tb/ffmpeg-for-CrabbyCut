index 0000000..1757b9a
--- /dev/null
+++ b/libavfilter/vf_crabgeo_cuda.cu
@@ -0,0 +1,310 @@
+/*
+ * CrabbyCut: hình học + đổi màu trên CUDA — lọc TÁCH ĐƯỢC hai lượt như swscale:
+ *   HPass: mặt phẳng nguồn -> bộ đệm float (cột = cột của mặt phẳng ra, hàng = hàng nguồn cần dùng)
+ *   VPass: bộ đệm -> mặt phẳng ra (ghi thẳng mã, hoặc ghi float cho lượt đổi màu)
+ *   Conv*: đổi ma trận/dải màu (nguồn YUV khác ma trận, hoặc nguồn RGB(A))
+ *   Copy:  tỉ lệ 1:1, toạ độ nguyên, không đổi màu -> chép thẳng (kèm đổi định dạng/độ sâu bit).
+ * Bảng chỉ số/trọng số xếp THEO TAP (idx[t*len + i]) để các luồng liền nhau đọc ô liền nhau;
+ * idx[i] < 0 (tap 0) = mẫu ra nằm ngoài nội dung.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "vf_crabgeo_cuda.h"
+
+template <int B>
+__device__ static inline float rdt(const unsigned char *__restrict__ base, const CrabGeoIO &io, int x, int y)
+{
+    const unsigned char *row = base + y * io.linesize;
+    if (B == 2)
+        return ((const unsigned short *)row)[x * io.step + io.offset] * (1.0f / 256.0f);
+    return row[x * io.step + io.offset];
+}
+
+template <int B>
+__device__ static inline void wrt(unsigned char *__restrict__ base, const CrabGeoIO &io, int x, int y, float v)
+{
+    unsigned char *row = base + y * io.linesize;
+    if (B == 2) {
+        float q = v * 256.0f + (io.mask != 0xFFFF ? 32.0f : 0.5f);
+        q = q < 0.0f ? 0.0f : (q > 65535.0f ? 65535.0f : q);
+        ((unsigned short *)row)[x * io.step + io.offset] = (unsigned short)((int)q & io.mask);
+    } else {
+        float q = v + 0.5f;
+        q = q < 0.0f ? 0.0f : (q > 255.0f ? 255.0f : q);
+        row[x * io.step + io.offset] = (unsigned char)(int)q;
+    }
+}
+
+__device__ static inline float rd(const unsigned char *__restrict__ base, const CrabGeoIO &io, int x, int y)
+{
+    return io.bytes == 2 ? rdt<2>(base, io, x, y) : rdt<1>(base, io, x, y);
+}
+
+__device__ static inline void wr(unsigned char *__restrict__ base, const CrabGeoIO &io, int x, int y, float v)
+{
+    if (io.bytes == 2)
+        wrt<2>(base, io, x, y, v);
+    else
+        wrt<1>(base, io, x, y, v);
+}
+
+template <int B>
+__device__ static void hpass(const unsigned char *__restrict__ src, const CrabGeoIO &io, int r0, int rows,
+                             const int *__restrict__ idx, const float *__restrict__ w, int taps,
+                             float *__restrict__ hbuf, int pw)
+{
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    int r = blockIdx.y * blockDim.y + threadIdx.y;
+    if (i >= pw || r >= rows)
+        return;
+    float acc = 0.0f;
+    if (idx[i] >= 0) {
+        for (int t = 0; t < taps; t++)
+            acc += w[t * pw + i] * rdt<B>(src, io, idx[t * pw + i], r0 + r);
+    }
+    hbuf[r * pw + i] = acc;
+}
+
+template <int B>
+__device__ static void vpass_out(const float *__restrict__ hbuf, int pw, int ph, int r0,
+                                 const int *__restrict__ idx, const float *__restrict__ w, int taps,
+                                 const int *__restrict__ hidx, unsigned char *__restrict__ dst,
+                                 const CrabGeoIO &io, float bg)
+{
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    int j = blockIdx.y * blockDim.y + threadIdx.y;
+    if (i >= pw || j >= ph)
+        return;
+    float v = bg;
+    if (idx[j] >= 0 && hidx[i] >= 0) {
+        v = 0.0f;
+        for (int t = 0; t < taps; t++)
+            v += w[t * ph + j] * hbuf[(idx[t * ph + j] - r0) * pw + i];
+    }
+    wrt<B>(dst, io, i, j, v);
+}
+
+/* Chép thẳng: mẫu ra (i, j) <- nguồn (i - dx, j - dy) nếu nằm trong [x0,x1)x[y0,y1), không thì bg. */
+template <int SB, int DB>
+__device__ static void copy_plane(const unsigned char *__restrict__ src, const CrabGeoIO &sio,
+                                  unsigned char *__restrict__ dst, const CrabGeoIO &dio,
+                                  int pw, int ph, int dx, int dy, int x0, int x1, int y0, int y1, float bg)
+{
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    int j = blockIdx.y * blockDim.y + threadIdx.y;
+    if (i >= pw || j >= ph)
+        return;
+    float v = bg;
+    if (i >= x0 && i < x1 && j >= y0 && j < y1)
+        v = rdt<SB>(src, sio, i - dx, j - dy);
+    wrt<DB>(dst, dio, i, j, v);
+}
+
+extern "C" {
+
+__global__ void CrabGeo_HPass8(const unsigned char *src, CrabGeoIO io, int r0, int rows,
+                               const int *idx, const float *w, int taps, float *hbuf, int pw)
+{
+    hpass<1>(src, io, r0, rows, idx, w, taps, hbuf, pw);
+}
+
+__global__ void CrabGeo_HPass16(const unsigned char *src, CrabGeoIO io, int r0, int rows,
+                                const int *idx, const float *w, int taps, float *hbuf, int pw)
+{
+    hpass<2>(src, io, r0, rows, idx, w, taps, hbuf, pw);
+}
+
+__global__ void CrabGeo_VPassOut8(const float *hbuf, int pw, int ph, int r0, const int *idx, const float *w,
+                                  int taps, const int *hidx, unsigned char *dst, CrabGeoIO io, float bg)
+{
+    vpass_out<1>(hbuf, pw, ph, r0, idx, w, taps, hidx, dst, io, bg);
+}
+
+__global__ void CrabGeo_VPassOut16(const float *hbuf, int pw, int ph, int r0, const int *idx, const float *w,
+                                   int taps, const int *hidx, unsigned char *dst, CrabGeoIO io, float bg)
+{
+    vpass_out<2>(hbuf, pw, ph, r0, idx, w, taps, hidx, dst, io, bg);
+}
+
+/* Lượt dọc -> float (cho lượt đổi màu); ngoài nội dung ghi `bg`. */
+__global__ void CrabGeo_VPassF(const float *__restrict__ hbuf, int pw, int ph, int r0,
+                               const int *__restrict__ idx, const float *__restrict__ w, int taps,
+                               const int *__restrict__ hidx, float *__restrict__ out, float bg)
+{
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    int j = blockIdx.y * blockDim.y + threadIdx.y;
+    if (i >= pw || j >= ph)
+        return;
+    float v = bg;
+    if (idx[j] >= 0 && hidx[i] >= 0) {
+        v = 0.0f;
+        for (int t = 0; t < taps; t++)
+            v += w[t * ph + j] * hbuf[(idx[t * ph + j] - r0) * pw + i];
+    }
+    out[j * pw + i] = v;
+}
+
+#define COPY_KERNEL(SB, DB) \
+__global__ void CrabGeo_Copy_##SB##_##DB(const unsigned char *src, CrabGeoIO sio, unsigned char *dst, CrabGeoIO dio, \
+                                       int pw, int ph, int dx, int dy, int x0, int x1, int y0, int y1, float bg) \
+{ \
+    copy_plane<SB, DB>(src, sio, dst, dio, pw, ph, dx, dy, x0, x1, y0, y1, bg); \
+}
+COPY_KERNEL(1, 1)
+COPY_KERNEL(1, 2)
+COPY_KERNEL(2, 1)
+COPY_KERNEL(2, 2)
+
+/* Alpha hằng (nguồn không có alpha): trong nội dung 255, ngoài = bg. */
+__global__ void CrabGeo_FillAlpha(int pw, int ph, const int *__restrict__ hidx, const int *__restrict__ vidx,
+                                  unsigned char *dst, CrabGeoIO io, float bg)
+{
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    int j = blockIdx.y * blockDim.y + threadIdx.y;
+    if (i >= pw || j >= ph)
+        return;
+    wr(dst, io, i, j, (hidx[i] >= 0 && vidx[j] >= 0) ? 255.0f : bg);
+}
+
+__device__ static inline float mat_row(const CrabGeoMat &m, int r, float a, float b, float c)
+{
+    return m.m[4 * r] * a + m.m[4 * r + 1] * b + m.m[4 * r + 2] * c + m.m[4 * r + 3];
+}
+
+__device__ static inline int clampi(int v, int lo, int hi)
+{
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+/* Nguồn YUV khác ma trận: luma ra từ Y (cỡ luma) + U,V (cỡ màu ra) nội suy song tuyến tại vị trí
+ * luma. (cox, coy) = tâm mẫu màu 0 theo toạ độ liên tục luma; csx, csy = bước hạ mẫu (1 hoặc 2). */
+__global__ void CrabGeo_ConvYUVLuma(const float *__restrict__ Y, const float *__restrict__ U,
+                                    const float *__restrict__ V, int w, int h,
+                                    int cw, int ch, float csx, float csy, float cox, float coy,
+                                    const int *__restrict__ hidx, const int *__restrict__ vidx,
+                                    CrabGeoMat m, unsigned char *dst, CrabGeoIO io, float bg)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= w || y >= h)
+        return;
+    float out = bg;
+    if (hidx[x] >= 0 && vidx[y] >= 0) {
+        float fx = (x + 0.5f - cox) / csx, fy = (y + 0.5f - coy) / csy;
+        int x0 = (int)floorf(fx), y0 = (int)floorf(fy);
+        float ax = fx - x0, ay = fy - y0;
+        int xa = clampi(x0, 0, cw - 1), xb = clampi(x0 + 1, 0, cw - 1);
+        int ya = clampi(y0, 0, ch - 1), yb = clampi(y0 + 1, 0, ch - 1);
+        float u = (1 - ay) * ((1 - ax) * U[ya * cw + xa] + ax * U[ya * cw + xb]) +
+                  ay * ((1 - ax) * U[yb * cw + xa] + ax * U[yb * cw + xb]);
+        float v = (1 - ay) * ((1 - ax) * V[ya * cw + xa] + ax * V[ya * cw + xb]) +
+                  ay * ((1 - ax) * V[yb * cw + xa] + ax * V[yb * cw + xb]);
+        out = mat_row(m, 0, Y[y * w + x], u, v);
+    }
+    wr(dst, io, x, y, out);
+}
+
+/* Nguồn YUV khác ma trận: màu ra từ U,V (cỡ màu) + Y trung bình các mẫu luma của khối. */
+__global__ void CrabGeo_ConvYUVChroma(const float *__restrict__ Y, const float *__restrict__ U,
+                                      const float *__restrict__ V, int w, int h,
+                                      int cw, int ch, int csx, int csy,
+                                      const int *__restrict__ hidx, const int *__restrict__ vidx,
+                                      CrabGeoMat m, unsigned char *dstu, CrabGeoIO iou,
+                                      unsigned char *dstv, CrabGeoIO iov)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= cw || y >= ch)
+        return;
+    float uo = 128.0f, vo = 128.0f;
+    if (hidx[x] >= 0 && vidx[y] >= 0) {
+        float ys = 0.0f;
+        int n = 0;
+        for (int j = 0; j < csy; j++)
+            for (int i = 0; i < csx; i++) {
+                int lx = x * csx + i, ly = y * csy + j;
+                if (lx < w && ly < h) {
+                    ys += Y[ly * w + lx];
+                    n++;
+                }
+            }
+        float yy = n ? ys / n : 16.0f;
+        float u = U[y * cw + x], v = V[y * cw + x];
+        uo = mat_row(m, 1, yy, u, v);
+        vo = mat_row(m, 2, yy, u, v);
+    }
+    wr(dstu, iou, x, y, uo);
+    wr(dstv, iov, x, y, vo);
+}
+
+/* Nguồn RGB(A) (cỡ luma ra): Y (+ A) ra. */
+__global__ void CrabGeo_ConvRGBLuma(const float *__restrict__ R, const float *__restrict__ G,
+                                    const float *__restrict__ B, const float *A,
+                                    int w, int h, const int *__restrict__ hidx, const int *__restrict__ vidx,
+                                    CrabGeoMat m, unsigned char *dsty, CrabGeoIO ioy,
+                                    unsigned char *dsta, CrabGeoIO ioa, float bgy, float bga)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= w || y >= h)
+        return;
+    int in = hidx[x] >= 0 && vidx[y] >= 0;
+    int k = y * w + x;
+    wr(dsty, ioy, x, y, in ? mat_row(m, 0, R[k], G[k], B[k]) : bgy);
+    if (dsta)
+        wr(dsta, ioa, x, y, in ? (A ? A[k] : 255.0f) : bga);
+}
+
+/* Nguồn RGB(A): màu ra = trung bình khối csx x csy luma (có trọng số alpha nếu wa). */
+__global__ void CrabGeo_ConvRGBChroma(const float *__restrict__ R, const float *__restrict__ G,
+                                      const float *__restrict__ B, const float *A,
+                                      int w, int h, int cw, int ch, int csx, int csy, int wa,
+                                      const int *__restrict__ hidx, const int *__restrict__ vidx,
+                                      CrabGeoMat m, unsigned char *dstu, CrabGeoIO iou,
+                                      unsigned char *dstv, CrabGeoIO iov)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= cw || y >= ch)
+        return;
+    float su = 0.0f, sv = 0.0f, sw = 0.0f;
+    for (int j = 0; j < csy; j++)
+        for (int i = 0; i < csx; i++) {
+            int lx = x * csx + i, ly = y * csy + j;
+            if (lx >= w || ly >= h || hidx[lx] < 0 || vidx[ly] < 0)
+                continue;
+            int k = ly * w + lx;
+            float wt = 1.0f;
+            if (wa && A) {
+                wt = A[k];
+                wt = wt < 0.0f ? 0.0f : (wt > 255.0f ? 255.0f : wt);
+            }
+            su += wt * (mat_row(m, 1, R[k], G[k], B[k]) - 128.0f);
+            sv += wt * (mat_row(m, 2, R[k], G[k], B[k]) - 128.0f);
+            sw += wt;
+        }
+    float uo = 128.0f, vo = 128.0f;
+    if (sw > 0.0f) {
+        uo = 128.0f + su / sw;
+        vo = 128.0f + sv / sw;
+    }
+    wr(dstu, iou, x, y, uo);
+    wr(dstv, iov, x, y, vo);
+}
+
+}
