+#ifndef AVFILTER_CRABGEO_CUDA_H
+#define AVFILTER_CRABGEO_CUDA_H
+
+#define CRABGEO_INTERP_BICUBIC  0
+#define CRABGEO_INTERP_BILINEAR 1
+#define CRABGEO_INTERP_NEAREST  2
+
+/* Cách đọc/ghi một thành phần trên một mặt phẳng: phần tử x của hàng y nằm ở
+ * base + y*linesize + (x*step + offset)*bytes. `norm` đổi mã <-> thang 8-bit (1 với 8-bit,
+ * 1/256 với 16-bit). Khi ghi: mã = v/norm + làm tròn, kẹp [0, maxval], AND mask. */
+typedef struct CrabGeoIO {
+    int linesize, step, offset, bytes;
+    float norm, maxval;
+    int mask;
+} CrabGeoIO;
+
+/* Ma trận 3x4 (thang 8-bit): out_i = m[4i]*a + m[4i+1]*b + m[4i+2]*c + m[4i+3]. */
+typedef struct CrabGeoMat {
+    float m[12];
+} CrabGeoMat;
+
+#endif /* AVFILTER_CRABGEO_CUDA_H */
