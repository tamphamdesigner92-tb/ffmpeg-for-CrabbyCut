+    FILTER_OUTPUTS(crabgeo_cuda_outputs),
+    FILTER_QUERY_FUNC2(crabgeo_query_formats),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
diff --git a/libavfilter/vf_crabgeo_cuda.cu b/libavfilter/vf_crabgeo_cuda.cu
