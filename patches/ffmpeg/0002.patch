 =?UTF-8?q?A=20ch=E1=BB=9D=20GPU=20t=E1=BB=ABng=20khung=20(sync=3D1),=20b?=
 =?UTF-8?q?=E1=BB=8F=20t=E1=BA=A3i=20l=C3=AAn=20qua=20b=E1=BB=99=20=C4=91?=
