+ *                                nhất khi 3 lượt xuất chạy song song. Chờ ở cả crabgeo, crabblend và
+ *                                lúc tải lên thì sạch (9/9 lượt) mà không chậm hơn (10–12 s cả hai).
  *
  * Mô hình toạ độ: tâm điểm ảnh luma i ở i + 0.5. Mẫu ra thứ i của một mặt phẳng nằm ở
  * off + i*sub (toạ độ luma khung ra); ánh xạ sang nguồn: crop + (X - pos) * ratio; rồi sang chỉ
@@ -115,7 +121,7 @@ typedef struct CrabGeoCUDAContext {
     int w, h, ow, oh;
     double x, y;
     int bg, interp, out_matrix, out_range, in_matrix, in_range;
-    int alpha_chroma, passthrough;
+    int alpha_chroma, passthrough, sync;
     int passthrough_geom;
 
     /* dựng từ định dạng/cỡ */
@@ -847,6 +853,8 @@ static int filter_frame(AVFilterLink *inlink, AVFrame *in)
         ret = build_tables(avctx, in->chroma_location);
     if (ret >= 0)
         ret = process(avctx, in, out, identity, &m);
+    if (ret >= 0 && s->sync)
+        ret = CHECK_CU(cu->cuStreamSynchronize(s->cu_stream));
     CHECK_CU(cu->cuCtxPopCurrent(&dummy));
     if (ret < 0)
         goto fail;
@@ -923,6 +931,7 @@ static const AVOption crabgeo_cuda_options[] = {
         { "pc",   NULL, 0, AV_OPT_TYPE_CONST, { .i64 = RNG_PC },   0, 0, FLAGS, .unit = "irng" },
     { "alpha_chroma", "alpha-weighted 4:2:0 chroma", OFFSET(alpha_chroma), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, FLAGS },
     { "passthrough", "pass frames through when nothing changes", OFFSET(passthrough), AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, FLAGS },
+    { "sync", "wait for the GPU to finish each output frame", OFFSET(sync), AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, FLAGS },
     { NULL },
 };
 
