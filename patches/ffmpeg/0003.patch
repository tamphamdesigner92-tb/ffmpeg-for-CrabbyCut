+/* YUV nguồn -> RGB thang 0..255 (cho bước LUT). Cùng hệ số với nửa đầu của build_matrix. */
+static void build_to_rgb(CrabGeoMat *out, int in_mat, int in_rng)
+{
+    const double ys = in_rng == RNG_TV ? 255.0 / 219.0 : 1.0;
+    const double yo = in_rng == RNG_TV ? -16.0 : 0.0;
+    const double cs = in_rng == RNG_TV ? 255.0 / 224.0 : 1.0;
+    double kr, kb, kg, rcr, bcb, gcb, gcr, a[3][4];
+    mat_coeffs(in_mat, &kr, &kb);
+    kg = 1.0 - kr - kb;
+    rcr = 2 * (1 - kr);
+    bcb = 2 * (1 - kb);
+    gcb = -kb * bcb / kg;
+    gcr = -kr * rcr / kg;
+    a[0][0] = ys; a[0][1] = 0;        a[0][2] = rcr * cs; a[0][3] = ys * yo - rcr * cs * 128;
+    a[1][0] = ys; a[1][1] = gcb * cs; a[1][2] = gcr * cs; a[1][3] = ys * yo - (gcb + gcr) * cs * 128;
+    a[2][0] = ys; a[2][1] = bcb * cs; a[2][2] = 0;        a[2][3] = ys * yo - bcb * cs * 128;
+    for (int i = 0; i < 3; i++)
+        for (int j = 0; j < 4; j++)
+            out->m[4 * i + j] = (float)a[i][j];
+}
