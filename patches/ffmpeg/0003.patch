+    if (s->lut2_file && *s->lut2_file) {
+        if ((ret = load_cube(avctx, s->lut2_file, &s->lut[1])) < 0)
+            return ret;
+        if (s->lut[1].n != s->lut[0].n) {
+            av_log(avctx, AV_LOG_ERROR, "lut and lut2 must have the same LUT_3D_SIZE\n");
+            return AVERROR(EINVAL);
+        }
+    }
+    ret = av_expr_parse(&s->mix_pexpr, s->mix_expr, mix_names, NULL, NULL, NULL, NULL, 0, avctx);
+    if (ret < 0)
+        av_log(avctx, AV_LOG_ERROR, "Invalid mix expression '%s'\n", s->mix_expr);
+    return ret;
+}
