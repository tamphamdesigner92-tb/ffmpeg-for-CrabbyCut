+/* Đọc .cube giống parse_cube của vf_lut3d: bỏ qua TITLE/chú thích/từ khoá khác, DOMAIN_MIN/MAX ->
+ * scale = clip(1/(max-min), 0, 1) (lut3d cũng chỉ co, không dời theo min), sau LUT_3D_SIZE là n^3
+ * bộ ba r g b, r chạy nhanh nhất. */
+static int load_cube(AVFilterContext *avctx, const char *path, CubeLut *lut)
+{
+    char line[512];
+    float minv[3] = { 0.0f, 0.0f, 0.0f }, maxv[3] = { 1.0f, 1.0f, 1.0f };
+    int n = 0, total = 0, count = 0, ret = 0;
+    FILE *f = avpriv_fopen_utf8(path, "r");
+
+    if (!f) {
+        ret = AVERROR(errno);
+        av_log(avctx, AV_LOG_ERROR, "%s: cannot open LUT file\n", path);
+        return ret;
+    }
+    while (count < total || !total) {
+        const char *p = line;
+        float r, g, b;
+        if (!fgets(line, sizeof(line), f))
+            break;
+        while (*p == ' ' || *p == '\t')
+            p++;
+        if (!*p || *p == '#' || *p == '\n' || *p == '\r')
+            continue;
+        if (!strncmp(p, "DOMAIN_MIN", 10) || !strncmp(p, "DOMAIN_MAX", 10)) {
+            float *v = p[8] == 'I' ? minv : maxv;
+            if (av_sscanf(p + 10, "%f %f %f", v, v + 1, v + 2) != 3) {
+                ret = AVERROR_INVALIDDATA;
+                goto end;
+            }
+            continue;
+        }
+        if (!strncmp(p, "LUT_3D_SIZE", 11)) {
+            n = strtol(p + 11, NULL, 0);
+            if (n < 2 || n > LUT_MAX_SIZE || lut->host) {
+                av_log(avctx, AV_LOG_ERROR, "%s: invalid LUT_3D_SIZE\n", path);
+                ret = AVERROR_INVALIDDATA;
+                goto end;
+            }
+            total = n * n * n;
+            lut->host = av_malloc_array(total, 4 * sizeof(float));
+            if (!lut->host) {
+                ret = AVERROR(ENOMEM);
+                goto end;
+            }
+            continue;
+        }
+        if ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z'))
+            continue;   /* TITLE, LUT_3D_INPUT_RANGE... */
+        if (!lut->host || av_sscanf(p, "%f %f %f", &r, &g, &b) != 3) {
+            ret = AVERROR_INVALIDDATA;
+            goto end;
+        }
+        lut->host[4 * count + 0] = r;
+        lut->host[4 * count + 1] = g;
+        lut->host[4 * count + 2] = b;
+        lut->host[4 * count + 3] = 0.0f;
+        count++;
+    }
+    if (!total || count != total) {
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+    lut->n = n;
+    for (int i = 0; i < 3; i++)
+        lut->scale[i] = av_clipf(1.0f / (maxv[i] - minv[i]), 0.0f, 1.0f);
+end:
+    if (ret == AVERROR_INVALIDDATA)
+        av_log(avctx, AV_LOG_ERROR, "%s: invalid .cube file\n", path);
+    fclose(f);
+    return ret;
+}
