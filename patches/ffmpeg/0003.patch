+/* LUT 3D (tuỳ chọn lut/lut2/mix) — nội suy ba chiều đúng như `lut3d=interp=trilinear`: chỉ số
+ * pos = v * scale * (n-1), prev = (int)pos, next = min(prev+1, n-1), trộn theo r rồi g rồi b.
+ * Bảng xếp theo thứ tự tệp .cube (r nhanh nhất): ô (r, g, b) ở r + n*(g + n*b). v thang 0..1 đã kẹp. */
+typedef struct LutVec {
+    float x, y, z;
+} LutVec;
+
+__device__ static inline LutVec lut_vec(float x, float y, float z)
+{
+    LutVec v = { x, y, z };
+    return v;
+}
+
+__device__ static inline LutVec lut_lerp(LutVec a, LutVec b, float t)
+{
+    return lut_vec(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
+}
+
+__device__ static inline LutVec lut_at(const float4 *__restrict__ lut, int n, int r, int g, int b)
+{
+    float4 v = lut[r + n * (g + n * b)];
+    return lut_vec(v.x, v.y, v.z);
+}
+
+__device__ static LutVec lut_sample(const float4 *__restrict__ lut, int n, float sr, float sg, float sb,
+                                    float r, float g, float b)
+{
+    const float m = (float)(n - 1);
+    float pr = r * sr * m, pg = g * sg * m, pb = b * sb * m;
+    int r0 = (int)pr, g0 = (int)pg, b0 = (int)pb;
+    int r1 = min(r0 + 1, n - 1), g1 = min(g0 + 1, n - 1), b1 = min(b0 + 1, n - 1);
+    float dr = pr - r0, dg = pg - g0, db = pb - b0;
+    LutVec c00 = lut_lerp(lut_at(lut, n, r0, g0, b0), lut_at(lut, n, r1, g0, b0), dr);
+    LutVec c10 = lut_lerp(lut_at(lut, n, r0, g1, b0), lut_at(lut, n, r1, g1, b0), dr);
+    LutVec c01 = lut_lerp(lut_at(lut, n, r0, g0, b1), lut_at(lut, n, r1, g0, b1), dr);
+    LutVec c11 = lut_lerp(lut_at(lut, n, r0, g1, b1), lut_at(lut, n, r1, g1, b1), dr);
+    return lut_lerp(lut_lerp(c00, c10, dg), lut_lerp(c01, c11, dg), db);
+}
+
+__device__ static inline float clamp01(float v)
+{
+    return v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v);
+}
+
+/* (R,G,B) thang 0..255 -> qua LUT -> thang 0..255. Có lutb: A + (B - A)*mix (như blend normal
+ * all_opacity=mix với ngõ đầu là B); không có: gốc + (A - gốc)*mix. */
+__device__ static LutVec apply_luts(const float4 *__restrict__ luta, const float4 *__restrict__ lutb, int n,
+                                    float ar, float ag, float ab, float br, float bg, float bb, float mix,
+                                    float R, float G, float B)
+{
+    float r = clamp01(R * (1.0f / 255.0f)), g = clamp01(G * (1.0f / 255.0f)), b = clamp01(B * (1.0f / 255.0f));
+    LutVec a = lut_sample(luta, n, ar, ag, ab, r, g, b);
+    LutVec o = lutb ? lut_lerp(a, lut_sample(lutb, n, br, bg, bb, r, g, b), mix)
+                    : lut_lerp(lut_vec(r, g, b), a, mix);
+    return lut_vec(o.x * 255.0f, o.y * 255.0f, o.z * 255.0f);
+}
+
+/* Nguồn RGB(A): LUT tại chỗ trên ba mặt phẳng float (cỡ luma ra), chỉ trong nội dung. */
+__global__ void CrabGeo_LutRGB(float *R, float *G, float *B, int w, int h,
+                               const int *__restrict__ hidx, const int *__restrict__ vidx,
+                               const float4 *luta, const float4 *lutb, int n,
+                               float ar, float ag, float ab, float br, float bg, float bb, float mix)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= w || y >= h || hidx[x] < 0 || vidx[y] < 0)
+        return;
+    int k = y * w + x;
+    LutVec o = apply_luts(luta, lutb, n, ar, ag, ab, br, bg, bb, mix, R[k], G[k], B[k]);
+    R[k] = o.x;
+    G[k] = o.y;
+    B[k] = o.z;
+}
+
+/* Nguồn YUV: tại mỗi mẫu luma ra, đổi (Y, U, V) sang RGB (ma trận `m`: YUV nguồn -> RGB thang
+ * 0..255), qua LUT, ghi ba mặt phẳng RGB cỡ luma — rồi CrabGeo_ConvRGBLuma/Chroma đổi sang YUV ra
+ * (màu 4:2:0 = trung bình khối 2x2 sau LUT). Màu của một điểm luma = mẫu màu ra của khối chứa nó
+ * (lặp ô), chỉ trong vùng nội dung [cxlo, cxhi] x [cylo, cyhi] của mặt phẳng màu (ngoài nội dung
+ * mặt phẳng float là 0). Đo trên nguồn DJI 10-bit, so bản chuẩn của bộ so 0.3 (RGB): lặp ô + trung
+ * bình khối 48,7 dB; song tuyến mẫu ở mép trái 46,1; bicubic mẫu ở giữa khối 48,0; hạ mẫu bicubic
+ * dọc kiểu swscale 48,1 — đường CPU 49,4 (bản chuẩn dựng từ chính đường CPU). */
+__global__ void CrabGeo_LutYUV(const float *__restrict__ Y, const float *__restrict__ U,
+                               const float *__restrict__ V, int w, int h,
+                               int cw, int ch, float csx, float csy, int cxlo, int cxhi, int cylo, int cyhi,
+                               const int *__restrict__ hidx, const int *__restrict__ vidx, CrabGeoMat m,
+                               float *R, float *G, float *B,
+                               const float4 *luta, const float4 *lutb, int n,
+                               float ar, float ag, float ab, float br, float bg, float bb, float mix)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= w || y >= h || hidx[x] < 0 || vidx[y] < 0)
+        return;
+    int k = y * w + x;
+    int ci = clampi((int)(x / csx), cxlo, cxhi) + clampi((int)(y / csy), cylo, cyhi) * cw;
+    float u = U[ci], v = V[ci];
+    float yy = Y[k];
+    LutVec o = apply_luts(luta, lutb, n, ar, ag, ab, br, bg, bb, mix,
+                          mat_row(m, 0, yy, u, v), mat_row(m, 1, yy, u, v), mat_row(m, 2, yy, u, v));
+    R[k] = o.x;
+    G[k] = o.y;
+    B[k] = o.z;
+}
+
 }
